#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
	cat <<'EOF'
Usage: star-citizen-install-profile --profile FILE --mappings-dir DIR
                                    [--name FILE.xml] [--dry-run]
   or: star-citizen-install-profile --restore-backup FILE --mappings-dir DIR
                                    --name FILE.xml [--dry-run]

Validate and atomically install an explicit Star Citizen profile. Existing
targets are backed up first. No installation discovery or registry change is
performed by this script.

Exit codes: 0 success, 2 invalid arguments, 3 unsafe path, 4 invalid XML,
5 write failure.
EOF
}

profile_transaction_cleanup() {
	local rc=$1
	local restore_temp=
	trap - EXIT INT TERM HUP
	[[ -z ${temp:-} ]] || rm -f -- "$temp"
	if [[ ${SPACEMOUSE_TEST_MODE:-0} == 1 && ${SPACEMOUSE_CLEANUP_FAILPOINT:-} == during-cleanup ]]; then
		printf 'Injected cleanup failure after temporary-file removal; any backup remains recoverable.\n' >&2
		exit 5
	fi
	if ((rc != 0)) && [[ ${published:-0} -eq 1 ]]; then
		if [[ ${had_target:-0} -eq 1 && -n ${backup:-} && -f $backup ]]; then
			if [[ ${SPACEMOUSE_TEST_MODE:-0} == 1 && ${SPACEMOUSE_CLEANUP_FAILPOINT:-} == during-rollback ]]; then
				printf 'Injected rollback failure; original data remains in its unique backup.\n' >&2
				exit 5
			fi
			restore_temp=$(mktemp "$mappings_dir/.$name.restore.XXXXXX") || exit 5
			cp -p -- "$backup" "$restore_temp" || {
				rm -f -- "$restore_temp"
				exit 5
			}
			mv -fT -- "$restore_temp" "$target" || {
				rm -f -- "$restore_temp"
				exit 5
			}
		else
			rm -f -- "$target"
		fi
	fi
	exit "$rc"
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/secure-files.sh
source "$script_dir/lib/secure-files.sh"

profile=
restore_backup=
mappings_dir=
name=
name_set=0
dry_run=0

while (($#)); do
	case "$1" in
	--profile)
		(($# >= 2)) || exit 2
		profile=$2
		shift 2
		;;
	--restore-backup)
		(($# >= 2)) || exit 2
		restore_backup=$2
		shift 2
		;;
	--mappings-dir)
		(($# >= 2)) || exit 2
		mappings_dir=$2
		shift 2
		;;
	--name)
		(($# >= 2)) || exit 2
		name=$2
		name_set=1
		shift 2
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'Unknown argument: %s\n' "$1" >&2
		exit 2
		;;
	esac
done

[[ -n $mappings_dir ]] || {
	usage >&2
	exit 2
}
if [[ -n $profile && -n $restore_backup ]] || [[ -z $profile && -z $restore_backup ]]; then
	printf 'Specify exactly one of --profile or --restore-backup.\n' >&2
	exit 2
fi
[[ -n $profile ]] || profile=$restore_backup
spacemouse_test_failpoint before-validation || exit 5
spacemouse_require_canonical_regular_file "$profile" 'Profile' "$SPACEMOUSE_MAX_XML_BYTES" || exit 3
spacemouse_validate_utf8_text "$profile" "$SPACEMOUSE_MAX_XML_BYTES" || {
	printf 'Profile must be bounded NUL-free UTF-8 XML.\n' >&2
	exit 4
}
[[ $mappings_dir == /* && -d $mappings_dir && ! -L $mappings_dir ]] || {
	printf 'Mappings directory is unsafe.\n' >&2
	exit 3
}
canonical_profile=$(realpath -- "$profile")
canonical_mappings=$(realpath -- "$mappings_dir")
[[ $canonical_profile == "$profile" && $canonical_mappings == "$mappings_dir" ]] || {
	printf 'Profile and mappings paths must be canonical and contain no symlink traversal.\n' >&2
	exit 3
}
profile=$canonical_profile
mappings_dir=$canonical_mappings

[[ -z $restore_backup || $name_set -eq 1 ]] || {
	printf -- '--name is required with --restore-backup.\n' >&2
	exit 2
}
[[ $name_set -eq 0 || -n $name ]] || {
	printf -- '--name must not be empty.\n' >&2
	exit 2
}
[[ -n $name ]] || name=$(basename -- "$profile")
[[ $name =~ ^layout_[A-Za-z0-9._-]+\.xml$ ]] || {
	printf 'Unsafe profile name: %s\n' "$name" >&2
	exit 2
}
target=$mappings_dir/$name
[[ ! -L $target ]] || {
	printf 'Refusing symlink target: %s\n' "$target" >&2
	exit 3
}
[[ ! -e $target || -f $target ]] || {
	printf 'Target is not a regular file.\n' >&2
	exit 3
}
[[ ! -e $target ]] || spacemouse_require_single_link "$target" 'Profile target' || exit 3

xml_validator=${SPACEMOUSE_XMLLINT:-}
if [[ -z $xml_validator ]]; then
	xml_validator=$(command -v xmllint || true)
fi
if [[ -x $xml_validator ]]; then
	if LC_ALL=C grep -Eiq '<![[:space:]]*(DOCTYPE|ENTITY)\b' "$profile"; then
		printf 'Document type and entity declarations are not allowed.\n' >&2
		exit 4
	fi
	"$xml_validator" --nonet --noout "$profile" || {
		printf 'Profile is not well-formed XML.\n' >&2
		exit 4
	}
else
	printf 'xmllint is required to validate the profile.\n' >&2
	exit 4
fi

profile_name=$("$xml_validator" --xpath 'string(/ActionMaps/@profileName)' "$profile")
profile_label=$("$xml_validator" --xpath 'string(/ActionMaps/CustomisationUIHeader/@label)' "$profile")
[[ $profile_name =~ ^[A-Za-z0-9._-]+$ && $profile_label == "$profile_name" ]] || {
	printf 'Profile name fields are missing, inconsistent, or unsafe.\n' >&2
	exit 4
}
spacemouse_test_failpoint after-validation || exit 5

if ((dry_run)); then
	printf 'DRY-RUN: would atomically install %s as %s\n' "$profile" "$target"
	[[ -e $target ]] && printf 'DRY-RUN: would back up the existing profile first\n'
	exit 0
fi

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup=
had_target=0
published=0
if [[ -e $target ]]; then
	had_target=1
	backup=$(mktemp "$target.backup.$timestamp.XXXXXX")
	cp -p -- "$target" "$backup" || exit 5
	printf 'Backup created: %s\n' "$backup"
fi
spacemouse_test_failpoint after-backup || exit 5

temp=$(mktemp "$mappings_dir/.$name.tmp.XXXXXX")
trap 'profile_transaction_cleanup "$?"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
spacemouse_test_failpoint during-candidate-write || exit 5
install -m 0644 -- "$profile" "$temp" || exit 5
spacemouse_test_failpoint before-rename || exit 5
if ((had_target)); then
	[[ -f $target && ! -L $target ]] && spacemouse_require_single_link "$target" 'Profile target' || exit 5
else
	[[ ! -e $target && ! -L $target ]] || exit 5
fi
mv -f -- "$temp" "$target" || exit 5
temp=
published=1
spacemouse_test_failpoint after-rename || exit 5
published=0
trap - EXIT INT TERM HUP
printf 'Installed: %s\n' "$target"
