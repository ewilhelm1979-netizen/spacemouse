#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
	cat <<'EOF'
Usage: spacemouse-detect [--vendor HEX] [--product HEX] [--dry-run]
                         [--dev-root ABS --sys-root ABS]

Find matching hidraw, event, and joystick nodes using bounded USB ancestors.
Defaults: --vendor 256f --product c63a

The root overrides are a read-only test seam and must be supplied together.

Exit codes: 0 found, 2 invalid arguments, 3 not found, 4 dependency missing.
EOF
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/spacemouse-device.sh
source "$script_dir/lib/spacemouse-device.sh"

vendor=256f
product=c63a
dry_run=0
dev_root=/dev
sys_root=/sys
dev_root_set=0
sys_root_set=0

while (($#)); do
	case "$1" in
	--vendor)
		(($# >= 2)) || {
			printf 'Missing value for --vendor\n' >&2
			exit 2
		}
		vendor=${2,,}
		shift 2
		;;
	--product)
		(($# >= 2)) || {
			printf 'Missing value for --product\n' >&2
			exit 2
		}
		product=${2,,}
		shift 2
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	--dev-root)
		(($# >= 2)) || {
			printf 'Missing value for --dev-root\n' >&2
			exit 2
		}
		dev_root=$2
		dev_root_set=1
		shift 2
		;;
	--sys-root)
		(($# >= 2)) || {
			printf 'Missing value for --sys-root\n' >&2
			exit 2
		}
		sys_root=$2
		sys_root_set=1
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'Unknown argument: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

[[ $vendor =~ ^[0-9a-f]{4}$ && $product =~ ^[0-9a-f]{4}$ ]] || {
	printf 'Vendor and product must be lowercase four-digit hexadecimal IDs.\n' >&2
	exit 2
}

((dev_root_set == sys_root_set)) || {
	printf -- '--dev-root and --sys-root must be supplied together.\n' >&2
	exit 2
}
if ((dry_run)); then
	[[ $dev_root == /* && $sys_root == /* && $dev_root != *'/../'* && $sys_root != *'/../'* ]] || {
		printf 'Dry-run roots must be absolute and contain no traversal.\n' >&2
		exit 2
	}
	printf 'DRY-RUN: would inspect %s/hidraw* and %s/input/{event*,js*} for USB ancestor %s:%s under %s\n' \
		"$dev_root" "$dev_root" "$vendor" "$product" "$sys_root"
	exit 0
fi
dev_root=$(spacemouse_canonical_root "$dev_root") || {
	printf 'Unsafe device root: %s\n' "$dev_root" >&2
	exit 2
}
sys_root=$(spacemouse_canonical_root "$sys_root") || {
	printf 'Unsafe sysfs root: %s\n' "$sys_root" >&2
	exit 2
}

command -v udevadm >/dev/null || {
	printf 'udevadm is required.\n' >&2
	exit 4
}
shopt -s nullglob

matches=0
hidraw_matches=0
for node in "$dev_root"/hidraw* "$dev_root"/input/event* "$dev_root"/input/js*; do
	spacemouse_node_is_safe "$node" "$dev_root" || continue
	spacemouse_usb_ancestor_matches "$node" "$vendor" "$product" "$sys_root" || continue
	properties=$(udevadm info --query=property --name "$node" 2>/dev/null || true)

	((matches += 1))
	[[ $node == "$dev_root"/hidraw* ]] && ((hidraw_matches += 1))
	printf 'NODE=%s\n' "$node"
	stat -c 'MODE=%a OWNER=%U:%G' "$node"
	grep -E '^(ID_BUS|ID_VENDOR|ID_MODEL|ID_VENDOR_ID|ID_MODEL_ID|ID_PATH|TAGS|CURRENT_TAGS)=' <<<"$properties" || true
done

printf 'MATCHING_NODES=%d\n' "$matches"
printf 'MATCHING_HIDRAW_NODES=%d\n' "$hidraw_matches"
((hidraw_matches > 0)) || exit 3
