#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
	cat <<'EOF'
Usage: spacemouse-verify-access [--device /dev/hidrawN]
                                [--vendor HEX --product HEX] [--dry-run]
                                [--dev-root ABS --sys-root ABS]

Verify current-user read/write access to an explicit or dynamically detected
SpaceMouse HIDRAW node.

The root overrides are a read-only test seam and must be supplied together.

Exit codes: 0 accessible, 2 invalid arguments, 3 not found, 4 dependency
missing, 5 insufficient access.
EOF
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/spacemouse-device.sh
source "$script_dir/lib/spacemouse-device.sh"

device=
vendor=256f
product=c63a
dry_run=0
dev_root=/dev
sys_root=/sys
dev_root_set=0
sys_root_set=0

while (($#)); do
	case "$1" in
	--device)
		(($# >= 2)) || {
			printf 'Missing value for --device\n' >&2
			exit 2
		}
		device=$2
		shift 2
		;;
	--vendor)
		(($# >= 2)) || {
			printf 'Missing value for --vendor\n' >&2
			exit 2
		}
		vendor=${2,,}
		shift 2
		;;
	--product)
		(($# >= 2)) || {
			printf 'Missing value for --product\n' >&2
			exit 2
		}
		product=${2,,}
		shift 2
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	--dev-root)
		(($# >= 2)) || {
			printf 'Missing value for --dev-root\n' >&2
			exit 2
		}
		dev_root=$2
		dev_root_set=1
		shift 2
		;;
	--sys-root)
		(($# >= 2)) || {
			printf 'Missing value for --sys-root\n' >&2
			exit 2
		}
		sys_root=$2
		sys_root_set=1
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'Unknown argument: %s\n' "$1" >&2
		exit 2
		;;
	esac
done

[[ $vendor =~ ^[0-9a-f]{4}$ && $product =~ ^[0-9a-f]{4}$ ]] || exit 2
((dev_root_set == sys_root_set)) || {
	printf -- '--dev-root and --sys-root must be supplied together.\n' >&2
	exit 2
}
if ((dry_run)); then
	[[ $dev_root == /* && $sys_root == /* && $dev_root != *'/../'* && $sys_root != *'/../'* ]] || {
		printf 'Dry-run roots must be absolute and contain no traversal.\n' >&2
		exit 2
	}
	if [[ -n $device ]]; then
		printf 'DRY-RUN: would verify read/write access to %s\n' "$device"
	else
		printf 'DRY-RUN: would locate and verify HIDRAW access for %s:%s\n' "$vendor" "$product"
	fi
	exit 0
fi
dev_root=$(spacemouse_canonical_root "$dev_root") || {
	printf 'Unsafe device root: %s\n' "$dev_root" >&2
	exit 2
}
sys_root=$(spacemouse_canonical_root "$sys_root") || {
	printf 'Unsafe sysfs root: %s\n' "$sys_root" >&2
	exit 2
}

command -v udevadm >/dev/null || {
	printf 'udevadm is required.\n' >&2
	exit 4
}

if [[ -z $device ]]; then
	shopt -s nullglob
	devices=()
	for candidate in "$dev_root"/hidraw*; do
		spacemouse_node_is_safe "$candidate" "$dev_root" || continue
		spacemouse_usb_ancestor_matches "$candidate" "$vendor" "$product" "$sys_root" || continue
		devices+=("$candidate")
	done
	((${#devices[@]} == 1)) || {
		printf 'Expected exactly one matching HIDRAW node, found %d.\n' "${#devices[@]}" >&2
		exit 3
	}
	device=${devices[0]}
fi

device_name=${device#"$dev_root"/}
if [[ $device != "$dev_root"/* || ! $device_name =~ ^hidraw[0-9]+$ ]] ||
	! spacemouse_node_is_safe "$device" "$dev_root"; then
	printf 'Not a valid HIDRAW character device: %s\n' "$device" >&2
	exit 3
fi
spacemouse_usb_ancestor_matches "$device" "$vendor" "$product" "$sys_root" || {
	printf 'No matching USB ancestor for %s.\n' "$device" >&2
	exit 3
}

printf 'DEVICE=%s\n' "$device"
stat -c 'MODE=%a OWNER=%U:%G' "$device"
if command -v getfacl >/dev/null; then
	getfacl -cp "$device"
fi

readable=NO
writable=NO
[[ -r $device ]] && readable=YES
[[ -w $device ]] && writable=YES
printf 'CURRENT_USER_READ=%s\n' "$readable"
printf 'CURRENT_USER_WRITE=%s\n' "$writable"

if [[ $readable == YES && $writable == YES ]]; then
	printf 'CURRENT_USER_RW=YES\n'
	exit 0
fi

printf 'CURRENT_USER_RW=NO\n' >&2
exit 5
